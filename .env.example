# Copy to .env. Do not commit .env to GitHub.
LANRARAGI_IMAGE=lanraragi-r2:local
LANRARAGI_PORT=3000
LRR_UID=9001
LRR_GID=9001
# Leave R2 values empty to use the web settings page.
LRR_R2_ENABLED=
LRR_R2_ENDPOINT=
LRR_R2_BUCKET=
LRR_R2_ACCESS_KEY_ID=
LRR_R2_SECRET_ACCESS_KEY=
LRR_R2_PUT_TTL=
LRR_R2_GET_TTL=
